# ==============================================================================
# .gitignore — BLIP-DRNet Project
# Files and folders excluded from Git tracking
# ==============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
*.pyc
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.conda/
conda-env/

# ── Jupyter / IPython ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_config.py

# ── Dataset (Large files — do not push to GitHub) ─────────────────────────────
data/
*.zip

# ── Model Checkpoints (Large binaries — share via Kaggle/Drive) ───────────────
checkpoints/
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.joblib

# ── Images directory ──────────────────────────────────────────────────────────
images/GAN_APTOS/
images/GAN_MESSIDOR/

# ── Temporary Experiment Outputs ──────────────────────────────────────────────
runs/
outputs/
wandb/
mlruns/
*.log
logs/

# ── LaTeX directory (Thesis documents) ────────────────────────────────────────
Latex/

# ── Reference Papers (PDFs — literature review) ──────────────────────────────
paper/

# ── Kaggle output cache ───────────────────────────────────────────────────────
/kaggle/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
tmp/
temp/
